# Виртуальное окружение и библиотеки
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Сгенерированные документы — результат работы, в репозитории не хранится
output/*
!output/.gitkeep

# Локальные шрифты (файлы лицензируются отдельно, вес ~100+ КБ каждый)
fonts/*
!fonts/.gitkeep

# Кэши и временные файлы
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp