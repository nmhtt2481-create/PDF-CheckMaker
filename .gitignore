# Виртуальное окружение и библиотеки
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Реальные данные клиентов. Папка data/ игнорируется целиком,
# разрешены только демонстрационные файлы из репозитория.
# Свои рабочие CSV с реальными данными сюда НЕ добавляйте.
data/*
!data/.gitkeep
!data/orders.csv
!data/clients/
data/clients/*
!data/clients/clients.csv

# Сгенерированные документы — результат работы, в репозиторий не коммитится.
# Реальные чеки клиентов НЕ должны попасть в публичный репозиторий.
output/*
!output/.gitkeep

# Локальные шрифты. В репозитории лежат только открытые Carlito (OFL-1.1),
# чтобы демо работало сразу после клонирования. Остальные файлы игнорируются.
fonts/*
!fonts/.gitkeep
!fonts/Carlito-Regular.ttf
!fonts/Carlito-Bold.ttf
!fonts/OFL.txt

# Секреты и логи
*.env
.env
*.log

# Кэши и временные файлы
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp